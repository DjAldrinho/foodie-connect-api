# =============================================================================
  # FOODIE CONNECT API
  # =============================================================================

  # PostgreSQL Configuration (TypeORM)
  POSTGRES_USER=foodie_user
  POSTGRES_PASSWORD=foodie_pass
  POSTGRES_DB=foodie_db
  POSTGRES_PORT=5433

  # TypeORM connection
  DB_HOST=localhost
  DB_PORT=5433
  DB_USERNAME=foodie_user
  DB_PASSWORD=foodie_pass
  DB_DATABASE=foodie_db
  DB_SYNCHRONIZE=true
  DB_LOGGING=true

  # MongoDB Configuration (Mongoose)
  MONGO_USER=foodie_user
  MONGO_PASSWORD=foodie_pass
  MONGO_PORT=27017

  # Mongoose connection string
  MONGO_URI=mongodb://foodie_user:foodie_pass@localhost:27017/foodie_db?authSource=admin

  # pgAdmin Configuration
  PGADMIN_EMAIL=admin@foodie.dev
  PGADMIN_PASSWORD=admin123
  PGADMIN_PORT=5051

  # Mongo-Express Configuration
  ME_USER=admin
  ME_PASSWORD=admin123
  ME_PORT=8081

  # NestJS Application
  PORT=3000
  NODE_ENV=development